<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>おはログ | 朝のはじまり</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# スタイルは Tailwind に一本化（トークンと部品は app/assets/tailwind/application.css） %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body class="bg-canvas text-ink-body antialiased"<%= " data-user-id=#{current_user.id}".html_safe if logged_in? %>>
    <%# PC: 上部ナビ / モバイル(ログイン時): 下部タブ。ナビは画面幅で出し分ける %>
    <%= render "shared/navbar" %>
    <%= render "shared/flash_message" %>

    <%= yield %>

    <%# 進行中のタイマーを、どの画面でも小さく表示する（タップでルーティンへ） %>
    <%= render "shared/timer_badge" if logged_in? %>
    <%= render "shared/tabbar" if logged_in? %>
    <%= render "shared/footer" %>
  </body>
</html>
