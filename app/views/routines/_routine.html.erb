<%# ルーティン1件のカード。Turbo Stream で丸ごと差し替えられるよう id を持つ。locals: routine, today_log(任意), notice(任意) %>
<% activity = routine.activity %>
<section id="<%= dom_id(routine) %>" class="card !p-4 tone-<%= routine.category %> scroll-mt-4 <%= 'card-celebrate' if local_assigns[:fresh] %>">
  <div class="flex items-center gap-4">
    <div class="icon-circle"><%= render "routines/icon", category: routine.category %></div>
    <div class="min-w-0 flex-1">
      <strong class="block text-lg text-ink"><%= routine.category_label %></strong>
      <span class="text-sm text-ink-muted"><%= routine.category_tagline %></span>
    </div>
    <span class="badge">レベル <%= routine.current_level %> / <%= Routine::MAX_LEVEL %></span>
  </div>

  <%# 進捗バー: 幅だけは動的な値なので style で渡す（色はトークン） %>
  <div class="meter mt-3"><i style="width: <%= routine.current_level * 100 / Routine::MAX_LEVEL %>%"></i></div>

  <p class="mt-3 text-ink-body"><%= routine.goal %></p>

  <% if routine.recorded_today? %>
    <%# 記録済み。タイマーなら完了の輪(セージ色)を見せ、途中でやめた場合も「できた分」を認める %>
    <%# サーバーに記録済み。ブラウザに残っているこのルーティンのタイマーの状態(ミニバッジなど)を片付ける %>
    <span data-controller="timer-clear" data-timer-clear-activity-key-value="<%= routine.category %>" hidden></span>
    <div class="success mt-3 <%= 'success-fresh' if local_assigns[:fresh] %>" role="status">
      <svg viewBox="0 0 24 24" class="success-check size-7 flex-none" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path pathLength="1" d="M5 12.5l4.5 4.5L19 7.5"/></svg>
      <p class="text-base font-bold"><%= today_log ? today_log.message : "Great job!" %></p>
      <% if local_assigns[:fresh] %>
        <%# 達成の瞬間に、小さな光がふわっと広がる %>
        <% 6.times do |i| %><span class="spark spark-<%= i + 1 %>" aria-hidden="true"></span><% end %>
      <% end %>
    </div>
  <% else %>
    <% if local_assigns[:notice].present? %><p class="mt-3 rounded-2xl bg-amber-soft px-4 py-3 text-sm text-ink-body" role="status"><%= notice %></p><% end %>
    <% if activity[:kind] == :timer %>
      <%= render "routines/ring_timer", routine: routine, seconds: routine.timer_seconds, pauseable: activity[:seconds] >= 300 %>
    <% else %>
      <%# 回数・行動の確認はワンタップで完了 %>
      <%= button_to "できた", activity_logs_path, method: :post, params: { activity_log: { activity_key: routine.category } },
                    class: "btn btn-tone mt-3 w-full" %>
    <% end %>
    <%= button_to "今日は休む", miss_routine_path(routine), method: :post, class: "btn btn-secondary mt-1.5 w-full" %>
  <% end %>
</section>
