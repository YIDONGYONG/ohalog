<%# ルーティン一覧: 4つのコアルーティンをカードで表示 %>
<div class="page">
  <%= render "shared/hero",
             title: safe_join(["ルーティン", tag.br, "小さな一歩を、ひとつずつ"]),
             lead: safe_join(["これまでに迎えた朝 ", tag.span(current_user.mornings_count, id: "mornings_count", class: "font-bold"), "回。1週間に#{WeeklyReview::PROMOTE_CLEAR_DAYS}日、4つすべてできる週が#{WeeklyReview::PROMOTE_STREAK_WEEKS}週続くとレベルが上がります。"]) %>

  <main class="page-body">
    <%# 4つすべて達成したときのお祝い演出が、ここに差し込まれる %>
    <div id="celebration"></div>

    <% if @missing_categories.any? %>
      <div class="card mb-4 py-8 text-center">
        <p class="mb-4 text-ink-muted">まずは、ごく小さな目標から始めましょう。</p>
        <%= button_to "レベル1からスタート", routines_path, method: :post, class: "btn btn-primary mx-auto w-full max-w-64" %>
      </div>
    <% end %>

    <div class="card-grid !gap-2 md:!gap-3">
      <% @routines.each do |routine| %>
        <%= render "routines/routine", routine: routine, today_log: @today_logs[routine.category] %>
      <% end %>
    </div>
  </main>
</div>
